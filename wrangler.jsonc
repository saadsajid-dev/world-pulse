{
  // Cloudflare Worker config: static site from ./site plus the /api routes in worker/index.js
  "name": "world-pulse",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,      // keep the free world-pulse.<account>.workers.dev address switched on
  "preview_urls": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "NEWS", "id": "1420e43cf5a244cf9312ffbd8aec4e60" }
  ],
  "ai": { "binding": "AI" },   // free Workers AI allowance: labels headlines and writes briefings
  "observability": { "enabled": true }
}
